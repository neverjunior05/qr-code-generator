DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-32-plus-random-characters
ANALYTICS_SALT=replace-with-independent-random-salt
# Optional real Google OAuth; leave unset for the honest local fallback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional destination check; local heuristics remain the fallback.
GOOGLE_SAFE_BROWSING_API_KEY=
# Demo scan simulator only
SIMULATE_COUNT=30
SIMULATE_INTERVAL_MS=2500
